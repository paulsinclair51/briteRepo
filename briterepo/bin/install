#!/usr/bin/env bash

# install - Install the briteRepo command scripts and reference
#           documentation to a standalone location on this system.
#
# See usage below for details, or run: bash install -h
#
# Copyright (c) 2026 Paul Sinclair
# SPDX-License-Identifier: MIT
# For license details, see '<repo>/LICENSE'.

usage() {
  cat <<'EOF'
Usage:
  install [-d DIR] [-r REF] [-u URL] [-y] [-v]
  install {-h | --help}

Install briteRepo as a standalone tool, separate from any repository you
use it to manage. Fetches a temporary copy of the source repository,
copies only the user-facing scripts, shared helpers, and a subset of
reference documentation into the target directory, and adds the target's
bin/ directory to PATH.

This command is meant to be run from a temporary clone (see the
Installation section of the Guide), not from a repository you manage day
to day. Rerunning it performs a total refresh of the target directory:
existing contents are removed and fully replaced, since the set of files
between versions can grow or shrink (helpers or subdirectories added or
removed).

Options:
  -d DIR      Target install directory (default: ~/briterepo).
  -r REF      Git branch or tag to install from (default: the highest
              vX.Y.Z release tag, or the default branch if no tags exist).
  -u URL      Source repository URL (default: the upstream briteRepo
              repository).
  -y          Do not prompt before replacing an existing target directory.
  -v          Output progress and diagnostics to stdout.
  -h, --help  Output this help to stdout and exit (other options and
              arguments are ignored).

Examples:
  # Install (or refresh) the latest release to ~/briterepo
  bash install

  # Install a specific version without a confirmation prompt
  bash install -r v1.2.0 -y

  # Install to a custom location
  bash install -d /opt/briterepo -y

Outputs:
  - Writes progress and next-step guidance to stdout.
  - Writes errors and diagnostics to stderr.
  - Removes and recreates the target directory (total refresh).
  - Modifies ~/.bashrc to add the target's bin/ directory to PATH.

Exit codes:
  0  Success
  1  Invalid option or argument
  2  Missing required tool (git)
  3  Git clone failed
  4  Install (copy or permission) step failed
  5  Existing target declined by user (no -y, refresh not confirmed)
EOF
}

# High-Level Flow:
# - Parse options; resolve the target directory, ref, and source URL.
# - Verify git is available and clone the requested ref to a temp directory.
# - Total-refresh the target directory: remove it if present (after
#   confirmation, unless -y), then recreate it from the clone's bin/,
#   helpers/, and a fixed subset of docs/.
# - Set permissions (555 scripts and hooks, 444 everything else, 755
#   directories) and generate a README.md guide in each directory.
# - Add the target's bin/ directory to PATH in ~/.bashrc (idempotent).

set -euo pipefail

readonly EXIT_INVALID_ARGUMENT=1
readonly EXIT_MISSING_DEPENDENCY=2
readonly EXIT_CLONE_FAILED=3
readonly EXIT_INSTALL_FAILED=4
readonly EXIT_REFRESH_DECLINED=5

readonly DEFAULT_REPO_URL="https://github.com/paulsinclair51/briteRepo.git"
readonly DEFAULT_TARGET_DIR="$HOME/briterepo"

bt_emit_error() {
  printf 'Error: %s\n' "$1" >&2
}

usage_error() {
  usage
  echo >&2
  bt_emit_error "$1. See usage above for details."
  exit "$EXIT_INVALID_ARGUMENT"
}

info() {
  [[ "$VERBOSE" == true ]] && echo "[INFO] $1"
  return 0
}

success() {
  echo "[SUCCESS] $1"
}

# Default options
TARGET_DIR="$DEFAULT_TARGET_DIR"
REPO_URL="$DEFAULT_REPO_URL"
REF=""
ASSUME_YES=false
VERBOSE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -d)
      [[ $# -ge 2 && -n "$2" ]] || usage_error "Option -d requires a directory"
      TARGET_DIR="$2"
      shift 2
      ;;
    -r)
      [[ $# -ge 2 && -n "$2" ]] || usage_error "Option -r requires a branch or tag"
      REF="$2"
      shift 2
      ;;
    -u)
      [[ $# -ge 2 && -n "$2" ]] || usage_error "Option -u requires a URL"
      REPO_URL="$2"
      shift 2
      ;;
    -y) ASSUME_YES=true; shift ;;
    -v) VERBOSE=true; shift ;;
    *) usage_error "Unknown argument: $1" ;;
  esac
done

if ! command -v git >/dev/null 2>&1; then
  bt_emit_error "missing required command: git"
  exit "$EXIT_MISSING_DEPENDENCY"
fi

# Resolve the ref to install when none was given: prefer the highest
# vX.Y.Z release tag, falling back to the remote's default branch.
if [[ -z "$REF" ]]; then
  info "Resolving latest release tag from $REPO_URL..."
  REF="$(git ls-remote --tags --refs --sort=-v:refname "$REPO_URL" \
    'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null | head -n1 | sed 's#.*refs/tags/##' || true)"
  if [[ -n "$REF" ]]; then
    info "Using latest release tag: $REF"
  else
    info "No release tags found; using the repository's default branch."
  fi
fi

TMP_CLONE="$(mktemp -d)"
cleanup() {
  rm -rf "$TMP_CLONE"
}
trap cleanup EXIT

info "Cloning $REPO_URL${REF:+ (ref: $REF)} to a temporary directory..."
if ! git clone --quiet --depth 1 ${REF:+--branch "$REF"} \
  "$REPO_URL" "$TMP_CLONE/src" 2>/dev/null; then
  bt_emit_error "git clone failed for $REPO_URL${REF:+ (ref: $REF)}"
  exit "$EXIT_CLONE_FAILED"
fi

SRC_BIN="$TMP_CLONE/src/briterepo/bin"
SRC_HELPERS="$TMP_CLONE/src/briterepo/bin/helpers"
SRC_DOCS_MD="$TMP_CLONE/src/docs/md"
SRC_DOCS_PDF="$TMP_CLONE/src/docs/pdf"
SRC_DOCS_DOCX="$TMP_CLONE/src/docs/docx"
SRC_DOCS_PNG="$TMP_CLONE/src/docs/branding"

if [[ ! -d "$SRC_BIN" || ! -d "$SRC_HELPERS" ]]; then
  bt_emit_error "cloned source is missing briterepo/bin or briterepo/bin/helpers"
  exit "$EXIT_INSTALL_FAILED"
fi

# Total refresh: the set of installed files can change between versions
# (helpers or subdirectories added or removed), so remove any existing
# target rather than reconciling individual files.
if [[ -e "$TARGET_DIR" ]]; then
  if [[ "$ASSUME_YES" != true ]]; then
    read -r -p "Replace existing $TARGET_DIR ? [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || {
      bt_emit_error "refresh declined; existing $TARGET_DIR left unchanged"
      exit "$EXIT_REFRESH_DECLINED"
    }
  fi
  info "Removing existing $TARGET_DIR..."
  rm -rf "$TARGET_DIR"
fi

info "Creating $TARGET_DIR..."
mkdir -p "$TARGET_DIR/bin/helpers/.githooks" \
  "$TARGET_DIR/docs/md" "$TARGET_DIR/docs/pdf" "$TARGET_DIR/docs/docx" \
  "$TARGET_DIR/docs/png"

# Scripts: readable and executable, not writable. Skip this installer
# itself; it is only ever run from a temporary clone, not the install.
info "Installing scripts to $TARGET_DIR/bin..."
for f in "$SRC_BIN"/*; do
  base="$(basename "$f")"
  [[ -f "$f" && "$base" != "README.md" && "$base" != "install" ]] || continue
  cp "$f" "$TARGET_DIR/bin/$base"
  chmod 555 "$TARGET_DIR/bin/$base"
done

# Helper libraries are sourced, not executed: read-only, no execute bit.
info "Installing helpers to $TARGET_DIR/bin/helpers..."
for f in "$SRC_HELPERS"/*.sh; do
  [[ -f "$f" ]] || continue
  base="$(basename "$f")"
  cp "$f" "$TARGET_DIR/bin/helpers/$base"
  chmod 444 "$TARGET_DIR/bin/helpers/$base"
done

# Git hooks are executed directly by git: readable and executable.
if [[ -d "$SRC_HELPERS/.githooks" ]]; then
  for f in "$SRC_HELPERS/.githooks"/*; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    cp "$f" "$TARGET_DIR/bin/helpers/.githooks/$base"
    if [[ "$base" == *.sh || "$base" == "README.md" ]]; then
      chmod 444 "$TARGET_DIR/bin/helpers/.githooks/$base"
    else
      chmod 555 "$TARGET_DIR/bin/helpers/.githooks/$base"
    fi
  done
fi

# Documentation subset: Guide, Contributor Guide, Contributor Reference,
# in md/pdf/docx form, plus their banner PNGs. A missing pdf/docx for a
# given document is a non-fatal warning (generation may lag a release).
info "Installing documentation to $TARGET_DIR/docs..."
for doc in Guide Contributor_Guide Contributor_Reference; do
  if [[ -f "$SRC_DOCS_MD/$doc.md" ]]; then
    cp "$SRC_DOCS_MD/$doc.md" "$TARGET_DIR/docs/md/$doc.md"
    chmod 444 "$TARGET_DIR/docs/md/$doc.md"
  else
    echo "Warning: missing docs/md/$doc.md; skipped" >&2
  fi
  if [[ -f "$SRC_DOCS_PDF/$doc.pdf" ]]; then
    cp "$SRC_DOCS_PDF/$doc.pdf" "$TARGET_DIR/docs/pdf/$doc.pdf"
    chmod 444 "$TARGET_DIR/docs/pdf/$doc.pdf"
  else
    echo "Warning: missing docs/pdf/$doc.pdf; skipped" >&2
  fi
  if [[ -f "$SRC_DOCS_DOCX/$doc.docx" ]]; then
    cp "$SRC_DOCS_DOCX/$doc.docx" "$TARGET_DIR/docs/docx/$doc.docx"
    chmod 444 "$TARGET_DIR/docs/docx/$doc.docx"
  else
    echo "Warning: missing docs/docx/$doc.docx; skipped" >&2
  fi
  if [[ -f "$SRC_DOCS_PNG/$doc.png" ]]; then
    cp "$SRC_DOCS_PNG/$doc.png" "$TARGET_DIR/docs/png/$doc.png"
    chmod 444 "$TARGET_DIR/docs/png/$doc.png"
  else
    echo "Warning: missing docs/branding/$doc.png; skipped" >&2
  fi
done

info "Writing directory guides..."

cat > "$TARGET_DIR/README.md" <<'EOF'
# `~/briterepo/`

Installed briteRepo command scripts and reference documentation.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT

This directory is fully managed by `install` and is replaced on every
run (a total refresh), so do not edit files here directly. To change
behavior, contribute to the source repository instead:
https://github.com/paulsinclair51/briteRepo

## Subdirectories

**bin/**: User-facing command scripts (added to PATH) and `bin/helpers/`,
the shared shell libraries they source and the Git hooks installed into
repositories you manage with those scripts.

**docs/**: The Guide, Contributor Guide, and Contributor Reference, in
Markdown, PDF, and DOCX form, plus their banner images.

## Updating

Rerun the installer to refresh this directory to a specific or the
latest release:

    bash install [-r REF] [-y]
EOF
chmod 444 "$TARGET_DIR/README.md"

cat > "$TARGET_DIR/bin/README.md" <<'EOF'
# `~/briterepo/bin/`

Installed command scripts, available by name once this directory is on
PATH.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT

Run any command with `-h` for its usage, prerequisites, and exit codes.
Scripts are read-only and executable (mode 555); rerunning `install`
replaces them.
EOF
chmod 444 "$TARGET_DIR/bin/README.md"

cat > "$TARGET_DIR/bin/helpers/README.md" <<'EOF'
# `~/briterepo/bin/helpers/`

Shared shell libraries sourced by the scripts in `~/briterepo/bin/`, and
Git hooks (`.githooks/`) installed into repositories you manage with
those scripts.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT

These files are not meant to be run directly by name. Library files
(`*.sh`) are read-only (mode 444); Git hooks are read-only and
executable (mode 555).
EOF
chmod 444 "$TARGET_DIR/bin/helpers/README.md"

cat > "$TARGET_DIR/docs/README.md" <<'EOF'
# `~/briterepo/docs/`

Reference documentation installed alongside the scripts in
`~/briterepo/bin/`.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT

## Subdirectories

**md/**: Markdown source for the Guide, Contributor Guide, and
Contributor Reference.

**pdf/**: Printer-friendly PDF versions of the same documents.

**docx/**: Word-compatible DOCX versions of the same documents.

**png/**: Banner images the Markdown documents embed.
EOF
chmod 444 "$TARGET_DIR/docs/README.md"

cat > "$TARGET_DIR/docs/md/README.md" <<'EOF'
# `~/briterepo/docs/md/`

Markdown source for the installed reference documentation.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT

## Files

**Guide.md**: User guide and quick start for briteRepo.

**Contributor_Guide.md**: Narrative guide for contributing to a
briteRepo-managed repository.

**Contributor_Reference.md**: Command and policy reference for
contributors.

Each file's banner image is in `../png/`.
EOF
chmod 444 "$TARGET_DIR/docs/md/README.md"

cat > "$TARGET_DIR/docs/pdf/README.md" <<'EOF'
# `~/briterepo/docs/pdf/`

Printer-friendly PDF versions of the documents in `../md/`.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT
EOF
chmod 444 "$TARGET_DIR/docs/pdf/README.md"

cat > "$TARGET_DIR/docs/docx/README.md" <<'EOF'
# `~/briterepo/docs/docx/`

Word-compatible DOCX versions of the documents in `../md/`.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT
EOF
chmod 444 "$TARGET_DIR/docs/docx/README.md"

cat > "$TARGET_DIR/docs/png/README.md" <<'EOF'
# `~/briterepo/docs/png/`

Banner images embedded at the top of each document in `../md/`.

Copyright (c) 2026 Paul Sinclair
SPDX-License-Identifier: MIT
EOF
chmod 444 "$TARGET_DIR/docs/png/README.md"

# Directories stay traversable and listable.
chmod 755 "$TARGET_DIR" "$TARGET_DIR/bin" "$TARGET_DIR/bin/helpers" \
  "$TARGET_DIR/bin/helpers/.githooks" "$TARGET_DIR/docs" "$TARGET_DIR/docs/md" \
  "$TARGET_DIR/docs/pdf" "$TARGET_DIR/docs/docx" "$TARGET_DIR/docs/png"

# Add the target's bin/ directory to PATH in ~/.bashrc, idempotently.
path_line="export PATH=\"$TARGET_DIR/bin:\$PATH\""
if grep -qxF "$path_line" ~/.bashrc 2>/dev/null; then
  info "PATH entry already present in ~/.bashrc"
else
  echo "$path_line" >> ~/.bashrc
  info "Added $TARGET_DIR/bin to PATH in ~/.bashrc"
fi

success "Installed briteRepo to $TARGET_DIR"
echo "Reload your shell to use the commands: source ~/.bashrc && hash -r"
echo "Then authenticate the GitHub CLI: gh auth login"
